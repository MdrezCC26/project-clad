// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  view
  edit
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken  String?
  refreshTokenExpires DateTime?
}

enum OrderLifecycleStatus {
  draft
  pending_review
  ready_to_order
  ordered
  delivered
  paid
}

enum JobFulfillmentMethod {
  delivery
  pickup
}

/// Default for how the customer receives project orders (drives address requirement + delivery fee display).
enum ProjectReceiveMode {
  delivery
  pickup
}

model Project {
  id                String            @id @default(cuid())
  shop              String
  name              String
  ownerCustomerId   String
  poNumber          String?
  companyName       String?
  cardImageDataUrl  String?
  /// Saved delivery address (required before customer can confirm order).
  shipAddress1      String?
  shipAddress2      String?
  shipCity          String?
  shipProvince      String?
  shipPostal        String?
  shipCountry       String?
  receiveMode       ProjectReceiveMode @default(pickup)
  /// Default site contact name autofilled into new orders.
  defaultSiteContactName  String?
  /// Default site contact phone autofilled into new orders.
  defaultSiteContactPhone String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  jobs             Job[]
  members          ProjectMember[]
  shareTokens      ProjectShareToken[]
  approvalRequests ApprovalRequest[]
  activityEvents   ProjectActivityEvent[]
  comments         ProjectComment[]

  @@index([shop])
  @@index([ownerCustomerId])
}

model Job {
  id                String      @id @default(cuid())
  projectId         String
  name              String
  /// Customer purchase order / reference (cart "PURCHASE ORDER #"), not the Shopify order name.
  purchaseOrderNumber String?
  /// On-site contact for THIS order. Autofilled from project default but editable per order.
  siteContactName   String?
  /// On-site contact phone for THIS order. Required before customer can place the order.
  siteContactPhone  String?
  createdAt         DateTime    @default(now())
  isLocked          Boolean     @default(false)
  sortOrder         Int         @default(0)
  /// Customer order lifecycle (Send for review → … → Paid). Independent of workOrderStatus.
  orderLifecycleStatus OrderLifecycleStatus @default(draft)
  /// Calendar date for scheduled delivery (Ottawa). Stored as YYYY-MM-DD.
  scheduledDeliveryDate   String?
  /// e.g. morning | afternoon | evening — free text allowed
  scheduledDeliveryWindow String?
  /// Set when the customer confirms Order now (delivery vs store pickup).
  fulfillmentMethod     JobFulfillmentMethod?
  /// Relative storage key under app storage dir (not a public URL).
  fulfillmentPhotoStorageKey String?
  /// Set when fulfillment emails + invoice hook ran (idempotency).
  fulfillmentNotifiedAt   DateTime?
  /// unread | in_progress | complete — only meaningful after job-level approval
  workOrderStatus   String?
  completedAt       DateTime?
  paidAt            DateTime?
  receiptSnapshot   Json?
  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items             JobItem[]
  orderLink         JobOrderLink?

  @@index([projectId])
  @@index([projectId, sortOrder])
}

model JobItem {
  id              String       @id @default(cuid())
  jobId           String
  variantId       String
  /// Shopify product ID (numeric). More stable than variant ID when variants are recreated.
  catalogProductId String?
  /// Variant SKU at last sync / save. Preferred business key when SKUs are unique and maintained.
  catalogSku      String?
  quantity        Int
  priceSnapshot   Decimal
  sortOrder       Int          @default(0)
  customData      Json?
  /// Last known product/variant labels from Shopify (filled when live API succeeds).
  variantSnapshot Json?
  /// Immutable line audit captured when the row is created (survives deleted Shopify variants).
  orderLineCapture Json?
  /// JSON map of line property index → relative path under `storage/upload-part-files` (mirrored Shopify staged uploads).
  uploadPartMirrorKeysJson String? @db.Text
  job             Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  drawingJob    DrawingJob?

  @@index([jobId])
  @@index([jobId, sortOrder])
  @@index([catalogSku])
}

model DrawingJob {
  id          String   @id @default(cuid())
  jobItemId   String   @unique
  shop        String
  status      String   @default("pending") // pending | processing | completed | failed
  shapeType   String   // L, Z, U
  l1          Float
  l2          Float
  l3          Float?   // for Z, U
  a1          Float?   // degrees
  gauge       Int
  partNumber  String?  // from local registry after creation
  errorMsg    String?  // if failed
  createdAt   DateTime @default(now())
  completedAt DateTime?
  jobItem     JobItem  @relation(fields: [jobItemId], references: [id], onDelete: Cascade)

  @@index([shop, status])
  @@index([status])
}

model ProjectMember {
  id         String      @id @default(cuid())
  projectId  String
  customerId String
  role       ProjectRole
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, customerId])
  @@index([customerId])
}

model ProjectShareToken {
  id        String      @id @default(cuid())
  projectId String
  token     String      @unique
  role      ProjectRole
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model JobOrderLink {
  id         String   @id @default(cuid())
  jobId      String   @unique
  orderId    String   @unique
  orderName  String?
  createdAt  DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model ProjectActivityEvent {
  id               String    @id @default(cuid())
  projectId        String
  jobId            String?
  type             String
  payload          Json?
  visibility       String
  actorCustomerId  String?
  createdAt        DateTime  @default(now())
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model ProjectComment {
  id                    String    @id @default(cuid())
  projectId             String
  authorCustomerId      String
  body                  String
  createdAt             DateTime  @default(now())
  deletedAt             DateTime?
  deletedByCustomerId   String?
  deletedByLabel        String?
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ApprovalRequest {
  id                   String    @id @default(cuid())
  projectId            String
  jobId                String    @default("")
  itemId               String    @default("")
  requestedAt          DateTime  @default(now())
  approvedAt           DateTime?
  approvedByCustomerId String?
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, jobId, itemId])
  @@index([projectId])
}

model GaugeConfig {
  id                String   @id @default(cuid())
  shop              String
  gauge             Int      // 16, 18, 20, 24, 26
  value             Decimal  // price rate: value × girth × 10
  /// Master rate last used when scaling Shopify variant prices (proportional updates).
  valueAtLastCatalogSync Decimal?
  thicknessInches   Decimal  // T1 for Inventor (e.g. 0.0598 for 16 ga)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, gauge])
  @@index([shop])
}

model ShopSettings {
  id                     String   @id @default(cuid())
  shop                   String   @unique
  /// Comma-separated Shopify customer IDs (numeric) with full storefront staff access (all projects, edit).
  appAdminCustomerIds    String?
  /// Comma or newline separated emails: global storefront staff (all projects). Matched to signed `logged_in_customer_email` — no Admin API.
  globalStaffEmails      String?
  logoDataUrl            String?
  backgroundLogoDataUrl  String?
  pricingPasswordHash  String?
  pricingPasswordSalt  String?
  navButton1Label      String?
  navButton1Url        String?
  navButton2Label      String?
  navButton2Url        String?
  navButton3Label      String?
  navButton3Url        String?
  /// Optional JSON array of { "label", "url" } for app-proxy storefront nav. If null, defaults + navButton1–3 are used.
  storefrontNavLinksJson String? @db.Text
  /// JSON map of notification kinds → boolean; null means all enabled (see DEFAULT_EMAIL_NOTIFICATION_PREFS).
  emailNotificationPrefsJson String? @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
