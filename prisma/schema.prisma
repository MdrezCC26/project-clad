// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  view
  edit
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken  String?
  refreshTokenExpires DateTime?
}

enum OrderLifecycleStatus {
  draft
  pending_review
  ready_to_order
  ordered
  delivered
  paid
}

enum JobFulfillmentMethod {
  delivery
  pickup
}

/// Per-order delivery choice relative to project defaults.
enum JobDeliveryMode {
  inherit
  pickup
  delivery
}

/// Default for how the customer receives project orders (drives address requirement + delivery fee display).
enum ProjectReceiveMode {
  delivery
  pickup
}

/// Storefront projects list tile / owner-set lifecycle (separate from job order lifecycle).
enum ProjectStorefrontStatus {
  active
  complete
  inactive
}

model Project {
  id                String            @id @default(cuid())
  shop              String
  name              String
  ownerCustomerId   String
  poNumber          String?
  companyName       String?
  cardImageDataUrl  String?
  /// Saved delivery address (required before customer can confirm order).
  shipAddress1      String?
  shipAddress2      String?
  shipCity          String?
  shipProvince      String?
  shipPostal        String?
  shipCountry       String?
  receiveMode       ProjectReceiveMode @default(pickup)
  /// Default site contact name autofilled into new orders.
  defaultSiteContactName  String?
  /// Default site contact phone autofilled into new orders.
  defaultSiteContactPhone String?
  /// Normalized company key (lowercased, whitespace-collapsed) derived from the owner's Shopify B2B company at project creation. Powers "projects from coworkers at the same company" read access.
  ownerCompanyKey   String?
  /// Owner switch to share a specific project with company viewers (read-only). Owner + members always see it regardless. Off by default — owners must opt in.
  visibleToCompany  Boolean           @default(false)
  storefrontStatus  ProjectStorefrontStatus @default(active)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  jobs             Job[]
  members          ProjectMember[]
  shareToken       ProjectShareToken?
  approvalRequests ApprovalRequest[]
  activityEvents   ProjectActivityEvent[]
  comments         ProjectComment[]

  @@index([shop])
  @@index([ownerCustomerId])
  @@index([shop, ownerCompanyKey])
}

model Job {
  id                String      @id @default(cuid())
  projectId         String
  name              String
  /// Internal sequential order number (starts at 1100), assigned on first transition to "ordered".
  orderNumber       Int?        @unique
  /// Customer purchase order / reference (cart "PURCHASE ORDER #"), not the Shopify order name.
  purchaseOrderNumber String?
  /// On-site contact for THIS order. Autofilled from project default but editable per order.
  siteContactName   String?
  /// On-site contact phone for THIS order. Required before customer can place the order.
  siteContactPhone  String?
  createdAt         DateTime    @default(now())
  isLocked          Boolean     @default(false)
  sortOrder         Int         @default(0)
  /// Customer order lifecycle (Send for review → … → Paid). Independent of workOrderStatus.
  orderLifecycleStatus OrderLifecycleStatus @default(draft)
  /// Calendar date for scheduled delivery (Ottawa). Stored as YYYY-MM-DD.
  scheduledDeliveryDate   String?
  /// e.g. morning | afternoon | evening — free text allowed
  scheduledDeliveryWindow String?
  /// Set when the customer confirms Order now (delivery vs store pickup).
  fulfillmentMethod     JobFulfillmentMethod?
  /// Per-order delivery: inherit project settings, force pickup, or delivery (optional job ship-to).
  deliveryMode          JobDeliveryMode @default(inherit)
  /// Last saved delivery plan: single | recurring (legacy: custom, at_a_time)
  deliveryPlanMode        String?
  /// JSON map of jobItemId → qty per delivery (recurring mode)
  deliveryBatchByItemJson String? @db.Text
  shipAddress1            String?
  shipCity                String?
  shipProvince            String?
  shipPostal              String?
  shipCountry             String?
  /// Relative storage key under app storage dir (not a public URL).
  fulfillmentPhotoStorageKey String?
  /// Relative storage key for customer-uploaded purchase order PDF.
  purchaseOrderPdfStorageKey String?
  /// Original filename of the uploaded purchase order PDF (display/download).
  purchaseOrderPdfFileName String?
  /// Set when fulfillment emails + invoice hook ran (idempotency).
  fulfillmentNotifiedAt   DateTime?
  /// unread | in_progress | complete — only meaningful after job-level approval
  workOrderStatus   String?
  completedAt       DateTime?
  paidAt            DateTime?
  receiptSnapshot   Json?
  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items             JobItem[]
  orderLink         JobOrderLink?
  draftOrderLink    JobDraftOrderLink?
  deliveryPhases    JobDeliveryPhase[]

  @@index([projectId])
  @@index([projectId, sortOrder])
}

/// One scheduled drop for a job (default: single phase with full qty). Pickup phases use deliveryFeeAmount 0.
model JobDeliveryPhase {
  id                        String   @id @default(cuid())
  jobId                     String
  /// 1-based sequence within the job.
  sequence                  Int
  scheduledDeliveryDate     String?
  scheduledDeliveryWindow   String?
  /// Snapshot of flat delivery fee charged on this phase (CAD).
  deliveryFeeAmount         Decimal? @db.Decimal(10, 2)
  fulfillmentPhotoStorageKey String?
  fulfillmentNotifiedAt     DateTime?
  deliveredAt               DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  job                       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lines                     JobDeliveryPhaseLine[]
  draftOrderLink            JobDeliveryPhaseDraftOrderLink?

  @@unique([jobId, sequence])
  @@index([jobId])
}

model JobDeliveryPhaseLine {
  id                 String           @id @default(cuid())
  phaseId            String
  jobItemId          String
  quantityPlanned    Int              @default(0)
  quantityDelivered  Int              @default(0)
  phase              JobDeliveryPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  jobItem            JobItem          @relation(fields: [jobItemId], references: [id], onDelete: Cascade)

  @@unique([phaseId, jobItemId])
  @@index([phaseId])
  @@index([jobItemId])
}

/// Per-phase Shopify draft for partial invoicing after fulfillment photo.
model JobDeliveryPhaseDraftOrderLink {
  id                  String           @id @default(cuid())
  phaseId             String           @unique
  shopifyDraftOrderId String           @unique
  createdAt           DateTime         @default(now())
  phase               JobDeliveryPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
}

model JobItem {
  id              String       @id @default(cuid())
  jobId           String
  variantId       String
  /// Shopify product ID (numeric). More stable than variant ID when variants are recreated.
  catalogProductId String?
  /// Variant SKU at last sync / save. Preferred business key when SKUs are unique and maintained.
  catalogSku      String?
  quantity        Int
  priceSnapshot   Decimal
  sortOrder       Int          @default(0)
  customData      Json?
  /// Last known product/variant labels from Shopify (filled when live API succeeds).
  variantSnapshot Json?
  /// Immutable line audit captured when the row is created (survives deleted Shopify variants).
  orderLineCapture Json?
  /// JSON map of line property index → relative path under `storage/upload-part-files` (mirrored Shopify staged uploads).
  uploadPartMirrorKeysJson String? @db.Text
  job             Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  drawingJob    DrawingJob?
  deliveryPhaseLines JobDeliveryPhaseLine[]

  @@index([jobId])
  @@index([jobId, sortOrder])
  @@index([catalogSku])
}

model DrawingJob {
  id          String   @id @default(cuid())
  jobItemId   String   @unique
  shop        String
  status      String   @default("pending") // pending | processing | completed | failed
  shapeType   String   // L, Z, U
  l1          Float
  l2          Float
  l3          Float?   // for Z, U
  a1          Float?   // degrees
  gauge       Int
  partNumber  String?  // from local registry after creation
  errorMsg    String?  // if failed
  createdAt   DateTime @default(now())
  completedAt DateTime?
  jobItem     JobItem  @relation(fields: [jobItemId], references: [id], onDelete: Cascade)

  @@index([shop, status])
  @@index([status])
}

model ProjectMember {
  id         String      @id @default(cuid())
  projectId  String
  customerId String
  role       ProjectRole
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, customerId])
  @@index([customerId])
}

model ProjectShareToken {
  id        String      @id @default(cuid())
  projectId String      @unique
  token     String      @unique
  role      ProjectRole
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model JobOrderLink {
  id         String   @id @default(cuid())
  jobId      String   @unique
  orderId    String   @unique
  orderName  String?
  createdAt  DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

/// Silent backup copy of a placed order in Shopify admin (Drafts). Never shown to customers.
model JobDraftOrderLink {
  id                  String   @id @default(cuid())
  jobId               String   @unique
  /// Shopify DraftOrder GID, e.g. "gid://shopify/DraftOrder/12345".
  shopifyDraftOrderId String   @unique
  createdAt           DateTime @default(now())
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model ProjectActivityEvent {
  id               String    @id @default(cuid())
  projectId        String
  jobId            String?
  type             String
  payload          Json?
  visibility       String
  actorCustomerId  String?
  createdAt        DateTime  @default(now())
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model ProjectComment {
  id                    String    @id @default(cuid())
  projectId             String
  authorCustomerId      String
  body                  String
  createdAt             DateTime  @default(now())
  deletedAt             DateTime?
  deletedByCustomerId   String?
  deletedByLabel        String?
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ApprovalRequest {
  id                   String    @id @default(cuid())
  projectId            String
  jobId                String    @default("")
  itemId               String    @default("")
  requestedAt          DateTime  @default(now())
  approvedAt           DateTime?
  approvedByCustomerId String?
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, jobId, itemId])
  @@index([projectId])
}

model GaugeConfig {
  id                String   @id @default(cuid())
  shop              String
  gauge             Int      // 16, 18, 20, 24, 26
  value             Decimal  // price rate: value × girth × 10
  /// Master rate last used when scaling Shopify variant prices (proportional updates).
  valueAtLastCatalogSync Decimal?
  thicknessInches   Decimal  // T1 for Inventor (e.g. 0.0598 for 16 ga)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, gauge])
  @@index([shop])
}

model ShopSettings {
  id                     String   @id @default(cuid())
  shop                   String   @unique
  /// Comma-separated Shopify customer IDs (numeric) with full storefront staff access (all projects, edit).
  appAdminCustomerIds    String?
  /// Comma or newline separated emails: global storefront staff (all projects). Matched to signed `logged_in_customer_email` — no Admin API.
  globalStaffEmails      String?
  logoDataUrl            String?
  backgroundLogoDataUrl  String?
  pricingPasswordHash  String?
  pricingPasswordSalt  String?
  navButton1Label      String?
  navButton1Url        String?
  navButton2Label      String?
  navButton2Url        String?
  navButton3Label      String?
  navButton3Url        String?
  /// Optional JSON array of { "label", "url" } for app-proxy storefront nav. If null, defaults + navButton1–3 are used.
  storefrontNavLinksJson String? @db.Text
  /// JSON map of notification kinds → boolean; null means all enabled (see DEFAULT_EMAIL_NOTIFICATION_PREFS).
  emailNotificationPrefsJson String? @db.Text
  /// Flat delivery fee per delivery phase (CAD). Null = app default ($15).
  deliveryFeeAmount        Decimal? @db.Decimal(10, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Durable fulfillment photo bytes keyed by Job/JobDeliveryPhase `fulfillmentPhotoStorageKey`.
model FulfillmentPhoto {
  storageKey  String   @id
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}

/// Durable purchase order PDF bytes keyed by Job `purchaseOrderPdfStorageKey`.
model PurchaseOrderPdf {
  storageKey  String   @id
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}
