# ProjectClad Drawing Worker
# Copy to .env and fill in values

# App API (e.g. https://your-app.fly.dev or http://localhost:3000 for dev)
API_BASE_URL=https://your-app.fly.dev

# Shop domain (e.g. projectclad.myshopify.com)
SHOP=projectclad.myshopify.com

# API key for worker auth. Leave empty in dev to use ?shop= bypass
DRAWING_WORKER_API_KEY=

# Base folder for DRAWINGS & MODELS (PDF and PNG subfolders)
# Must match converter.py WATCH_FOLDER parent
BASE_FOLDER=C:\Users\Micha\Desktop\Canadian Cladding\DRAWINGS & MODELS

# Poll interval in seconds
POLL_INTERVAL=30

# Path to L-shape Inventor template (.ipt) with parameters L1, L2, A1, T1
INVENTOR_L_TEMPLATE=
