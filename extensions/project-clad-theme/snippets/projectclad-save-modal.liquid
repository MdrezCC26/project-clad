{% comment %}
  Shared "Save to project" modal.

  Used by the cart block (cart-actions.liquid) and the product block
  (product-save-actions.liquid) so both flows share the same markup, styles,
  and JS module (project-clad-save-modal.js).

  Params:
    intent — 'cart' (default) or 'product'.
             - 'cart'    → header reads "Save cart to project", shows the
                           "Save order & Clear cart" submit + the "Quantity
                           mode" radios on the existingJob section.
             - 'product' → header reads "Save to project", hides the clear-
                           cart submit. Quantity mode radios stay visible
                           (Add vs Replace are still meaningful when adding
                           a single item to an existing order).
{% endcomment %}
{% assign pc_intent = intent | default: 'cart' %}
{% assign pc_modal_title = 'Save cart to project' %}
{% if pc_intent == 'product' %}
  {% assign pc_modal_title = 'Save to project' %}
{% endif %}

<div class="projectclad-modal" data-projectclad-modal data-projectclad-save-cart-modal hidden>
  <div
    class="projectclad-modal__content projectclad-reject-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="projectclad-save-modal-title"
  >
    <button class="projectclad-modal__close" type="button" data-projectclad-close aria-label="Close">&times;</button>
    <h2 id="projectclad-save-modal-title" data-projectclad-section-underline>{{ pc_modal_title }}</h2>
    <form class="projectclad-inline-form projectclad-pricing-form" data-projectclad-form>
      <label id="projectclad-save-mode-lbl">Save mode</label>
      <input type="hidden" data-projectclad-mode value="newProject" />
      <details
        class="project-clad-member-role-select"
        data-projectclad-member-role-select
        data-projectclad-save-mode-widget
      >
        <summary class="project-clad-member-role-select__trigger" aria-labelledby="projectclad-save-mode-lbl">
          <span class="project-clad-member-role-select__value" data-role-label>Create new project</span>
          <span class="project-clad-member-role-select__chevron" aria-hidden="true">▾</span>
        </summary>
        <div class="project-clad-member-role-select__panel">
          <div class="project-clad-member-role-select__list" role="group">
            <label class="project-clad-member-role-select__option" for="projectclad-save-mode-new">
              <input
                id="projectclad-save-mode-new"
                type="radio"
                name="projectclad-save-mode"
                value="newProject"
                class="project-clad-member-role-select__input"
                checked
              />
              <span class="project-clad-member-role-select__option-text">Create new project</span>
            </label>
            <label class="project-clad-member-role-select__option" for="projectclad-save-mode-existing">
              <input
                id="projectclad-save-mode-existing"
                type="radio"
                name="projectclad-save-mode"
                value="existingProject"
                class="project-clad-member-role-select__input"
              />
              <span class="project-clad-member-role-select__option-text">Save to existing project</span>
            </label>
            <label class="project-clad-member-role-select__option" for="projectclad-save-mode-job">
              <input
                id="projectclad-save-mode-job"
                type="radio"
                name="projectclad-save-mode"
                value="existingJob"
                class="project-clad-member-role-select__input"
              />
              <span class="project-clad-member-role-select__option-text">Save to existing order</span>
            </label>
          </div>
        </div>
      </details>

      <div class="projectclad-section" data-projectclad-section="newProject">
        <label for="projectclad-project-name">Project name *</label>
        <input
          id="projectclad-project-name"
          class="projectclad-pricing-password-input"
          type="text"
          data-projectclad-project-name
          required
        />
      </div>

      <div class="projectclad-section" data-projectclad-section="newProject">
        <div class="projectclad-field-row">
          <div class="projectclad-field">
            <label for="projectclad-po-number-new">Project #</label>
            <input
              id="projectclad-po-number-new"
              class="projectclad-pricing-password-input"
              type="text"
              data-projectclad-po
            />
          </div>
          <div class="projectclad-field">
            <label for="projectclad-job-name">Order name *</label>
            <input
              id="projectclad-job-name"
              class="projectclad-pricing-password-input"
              type="text"
              data-projectclad-job-name
              required
            />
          </div>
        </div>
        <div class="projectclad-field-row">
          <div class="projectclad-field">
            <label for="projectclad-company-name-new">Company name</label>
            <input
              id="projectclad-company-name-new"
              class="projectclad-pricing-password-input"
              type="text"
              data-projectclad-company
            />
          </div>
          <div class="projectclad-field">
            <label for="projectclad-order-number">PURCHASE ORDER #</label>
            <input
              id="projectclad-order-number"
              class="projectclad-pricing-password-input"
              type="text"
              data-projectclad-order-number
            />
          </div>
        </div>
      </div>

      <div class="projectclad-section" data-projectclad-section="existingProject" hidden>
        <label id="projectclad-project-existing-lbl">Project *</label>
        <div class="projectclad-picker-wrap" data-projectclad-project-wrap data-projectclad-project-radio-name="projectclad-project-existing">
          <details class="project-clad-member-role-select" data-projectclad-member-role-select data-projectclad-project-picker>
            <summary class="project-clad-member-role-select__trigger" aria-labelledby="projectclad-project-existing-lbl">
              <span class="project-clad-member-role-select__value" data-role-label>Select project</span>
              <span class="project-clad-member-role-select__chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="project-clad-member-role-select__panel">
              <div class="project-clad-member-role-select__list" data-projectclad-project-options role="group"></div>
            </div>
          </details>
          <input type="hidden" data-projectclad-project value="" required />
        </div>
        <div class="projectclad-field-row">
          <div class="projectclad-field">
            <label for="projectclad-po-number-existing">Project #</label>
            <input
              id="projectclad-po-number-existing"
              class="projectclad-pricing-password-input"
              type="text"
              data-projectclad-po
            />
          </div>
          <div class="projectclad-field">
            <label for="projectclad-job-name-existing">Order name *</label>
            <input
              id="projectclad-job-name-existing"
              class="projectclad-pricing-password-input"
              type="text"
              data-projectclad-job-name
              required
            />
          </div>
        </div>
        <div class="projectclad-field-row">
          <div class="projectclad-field">
            <label for="projectclad-company-name-existing">Company name</label>
            <input
              id="projectclad-company-name-existing"
              class="projectclad-pricing-password-input"
              type="text"
              data-projectclad-company
            />
          </div>
          <div class="projectclad-field">
            <label for="projectclad-order-number-existing">PURCHASE ORDER #</label>
            <input
              id="projectclad-order-number-existing"
              class="projectclad-pricing-password-input"
              type="text"
              data-projectclad-order-number
            />
          </div>
        </div>
      </div>

      <div class="projectclad-section" data-projectclad-section="existingJob" hidden>
        <label id="projectclad-project-job-lbl">Project *</label>
        <div class="projectclad-picker-wrap" data-projectclad-project-wrap data-projectclad-project-radio-name="projectclad-project-job">
          <details class="project-clad-member-role-select" data-projectclad-member-role-select data-projectclad-project-picker>
            <summary class="project-clad-member-role-select__trigger" aria-labelledby="projectclad-project-job-lbl">
              <span class="project-clad-member-role-select__value" data-role-label>Select project</span>
              <span class="project-clad-member-role-select__chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="project-clad-member-role-select__panel">
              <div class="project-clad-member-role-select__list" data-projectclad-project-options role="group"></div>
            </div>
          </details>
          <input type="hidden" data-projectclad-project value="" required />
        </div>
        <div class="projectclad-field-row">
          <div class="projectclad-field">
            <label for="projectclad-po-number-job">Project #</label>
            <input
              id="projectclad-po-number-job"
              class="projectclad-pricing-password-input"
              type="text"
              data-projectclad-po
            />
          </div>
          <div class="projectclad-field">
            <label for="projectclad-company-name-job">Company name</label>
            <input
              id="projectclad-company-name-job"
              class="projectclad-pricing-password-input"
              type="text"
              data-projectclad-company
            />
          </div>
        </div>
        <label id="projectclad-job-lbl">Order *</label>
        <div class="projectclad-picker-wrap" data-projectclad-job-wrap>
          <details class="project-clad-member-role-select" data-projectclad-member-role-select data-projectclad-job-picker>
            <summary class="project-clad-member-role-select__trigger" aria-labelledby="projectclad-job-lbl">
              <span class="project-clad-member-role-select__value" data-role-label>Select order</span>
              <span class="project-clad-member-role-select__chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="project-clad-member-role-select__panel">
              <div class="project-clad-member-role-select__list" data-projectclad-job-options role="group"></div>
            </div>
          </details>
          <input type="hidden" data-projectclad-job value="" required />
        </div>
        <fieldset class="projectclad-fieldset projectclad-fieldset--radios">
          <legend>Quantity mode</legend>
          <label class="projectclad-fieldset__choice">
            <input type="radio" name="projectclad-quantity" value="add" checked />
            Add quantities
          </label>
          <label class="projectclad-fieldset__choice">
            <input type="radio" name="projectclad-quantity" value="replace" />
            Replace quantities
          </label>
        </fieldset>
      </div>

      <div class="projectclad-modal-buttons projectclad-actions">
        {% if pc_intent == 'cart' %}
          <button
            class="projectclad-button projectclad-button--approve projectclad-reject-modal-btn"
            type="submit"
            data-projectclad-clear
          >
            Save order & Clear cart
          </button>
        {% endif %}
        <button class="projectclad-button projectclad-reject-modal-btn" type="submit">
          Save order
        </button>
      </div>
    </form>
  </div>
</div>

<div class="projectclad-modal projectclad-modal--duplicate" data-projectclad-duplicate-modal hidden>
  <div
    class="projectclad-modal__content projectclad-reject-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="projectclad-duplicate-title"
  >
    <button type="button" class="projectclad-modal__close" data-projectclad-duplicate-dismiss aria-label="Close">&times;</button>
    <h2 id="projectclad-duplicate-title" data-projectclad-section-underline>Duplicate project</h2>
    <p class="projectclad-duplicate-message">You already have a project with this name, are you sure you want to save another?</p>
    <div class="projectclad-duplicate-buttons projectclad-actions">
      <button type="button" class="projectclad-button projectclad-button--primary projectclad-reject-modal-btn" data-projectclad-duplicate-yes>Yes</button>
      <button type="button" class="projectclad-button projectclad-reject-modal-btn" data-projectclad-duplicate-no>No</button>
      <button type="button" class="projectclad-button projectclad-reject-modal-btn" data-projectclad-duplicate-merge>Merge projects</button>
    </div>
  </div>
</div>
