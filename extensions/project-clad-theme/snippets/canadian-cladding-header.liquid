{% comment %}
  Canadian Cladding storefront header (fragment).
  Wired from blocks/canadian-cladding-header.liquid (body app embed).
{% endcomment %}

{% liquid
  assign account_href = routes.account_login_url
  if customer
    assign account_href = routes.account_url
  endif
  assign path = request.path
  assign nav_siding_url = '/collections/main-products'
  assign nav_roofing_url = '/pages/roofing-shop'
  assign nav_glazing_url = '/pages/glazing-shop'
  assign nav_custom_url = '/pages/custompart'
  assign nav_projects_url = '/apps/project-clad/projects'
  assign nav_colours_url = '/pages/colours'
  assign nav_contact_url = '/pages/contact'
  assign nav_siding_active = false
  assign nav_roofing_active = false
  assign nav_glazing_active = false
  assign nav_custom_active = false
  assign nav_projects_active = false
  if path == nav_siding_url or path contains nav_siding_url
    assign nav_siding_active = true
  elsif path == nav_roofing_url or path contains nav_roofing_url
    assign nav_roofing_active = true
  elsif path == nav_glazing_url or path contains nav_glazing_url
    assign nav_glazing_active = true
  elsif path == nav_custom_url or path contains nav_custom_url
    assign nav_custom_active = true
  elsif path contains '/apps/project-clad/projects' or path contains '/apps/project-clad/project' or path contains '/apps/project-clad/work-orders'
    assign nav_projects_active = true
  endif
%}
<header class="cc-header" id="ccHeader" data-cc-header>

  <div class="cc-topbar">
    <div class="tb-info">
      <div class="tb-dot"></div>
      <span class="hi">OPEN</span>
      <span class="sep">|</span>
      <span>72HR LEAD TIME</span>
      <span class="sep">|</span>
      <span>OTTAWA, ON</span>
      <span class="sep">|</span>
      <span class="hi">245 PARTS IN SHOP</span>
    </div>

    <nav class="tb-right">
      <a href="{{ nav_contact_url }}" class="hide-mobile">CONTACT</a>
      <a href="{{ nav_colours_url }}" class="hide-mobile">COLOURS</a>
      <a href="{{ account_href }}">ACCOUNT</a>
      <a href="{{ routes.cart_url }}">CART <span class="cart-count">[{{ cart.item_count }}]</span></a>
    </nav>
  </div>

  <div class="cc-mainbar">
    <button type="button" class="cc-ham" aria-label="Menu" aria-expanded="false">☰</button>

    <a href="{{ routes.root_url }}" class="cc-logo" aria-label="Canadian Cladding">
      <span class="word">Canadian</span>
      <span class="cc-leaf">
        <img
          src="{{ 'cc-leaf.png' | asset_url }}"
          alt=""
          width="42"
          height="48"
          loading="eager"
        >
      </span>
      <span class="word">Cladding</span>
    </a>

    <nav class="cc-nav cc-nav--primary" aria-label="Primary">
      <a href="{{ nav_siding_url }}" class="{% if nav_siding_active %}active{% endif %}">
        {% if nav_siding_active %}<span class="active-tick"></span>{% endif %}
        Siding
      </a>
      <a href="{{ nav_roofing_url }}" class="{% if nav_roofing_active %}active{% endif %}">
        {% if nav_roofing_active %}<span class="active-tick"></span>{% endif %}
        Roofing
      </a>
      <a href="{{ nav_glazing_url }}" class="{% if nav_glazing_active %}active{% endif %}">
        {% if nav_glazing_active %}<span class="active-tick"></span>{% endif %}
        Glazing
      </a>
      <a href="{{ nav_custom_url }}" class="{% if nav_custom_active %}active{% endif %}">
        {% if nav_custom_active %}<span class="active-tick"></span>{% endif %}
        Custom
      </a>
      <a href="{{ nav_projects_url }}" class="{% if nav_projects_active %}active{% endif %}">
        {% if nav_projects_active %}<span class="active-tick"></span>{% endif %}
        Projects
      </a>
    </nav>

    <div class="cc-tools">
      <a href="{{ routes.search_url }}" aria-label="Search">⌕</a>
    </div>
  </div>
</header>
