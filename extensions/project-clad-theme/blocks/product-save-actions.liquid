{% comment %}
  Theme editor name: ProjectClad save.

  Keep this app block on calculator product templates. It loads
  project-clad-opc-prefill.js so Edit part can autofill OPC fields.
  The Save to Project button is not rendered — that path skips calculator
  pricing. Customers save from the cart instead.
{% endcomment %}

<script src="{{ 'project-clad-opc-prefill.js' | asset_url }}" defer></script>
<div
  class="projectclad-product-actions projectclad-product-actions--prefill-only"
  {{ block.shopify_attributes }}
  hidden
  aria-hidden="true"
></div>

{% schema %}
{
  "name": "ProjectClad save",
  "target": "section",
  "stylesheet": "project-clad-cart.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}
