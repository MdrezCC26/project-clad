{% assign view_projects_url = "https://" | append: request.host | append: "/apps/project-clad/projects" %}
{% assign has_custom_parts = false %}
{% for item in cart.items %}
  {% if item.properties.shape_type == "L" or item.properties.shape_type == "Z" or item.properties.shape_type == "U" %}
    {% assign has_custom_parts = true %}
    {% break %}
  {% endif %}
{% endfor %}
{% assign return_url_param = view_projects_url | url_encode %}
{% assign login_url = "/account/login?return_url=" | append: return_url_param %}
<div
  class="projectclad-cart-actions"
  data-projectclad
  data-projectclad-login-url="{% if customer %}{{ view_projects_url }}{% else %}{{ login_url }}{% endif %}"
  data-projectclad-projects-url="/apps/project-clad/api/projects"
  data-projectclad-save-url="/apps/project-clad/api/save-job"
  data-projectclad-view-projects-url="{% if customer %}{{ view_projects_url }}{% else %}{{ login_url }}{% endif %}"
  data-projectclad-has-custom-parts="{{ has_custom_parts }}"
>
    <div
      class="projectclad-modal projectclad-modal--checkout-fulfillment"
      data-projectclad-checkout-fulfillment-modal
      hidden
    >
      <div
        class="projectclad-modal__content"
        role="dialog"
        aria-modal="true"
        aria-labelledby="projectclad-checkout-fulfill-title"
      >
        <button
          type="button"
          class="projectclad-modal__close"
          data-projectclad-checkout-fulfill-close
          aria-label="Close"
        >
          &times;
        </button>
        <h2 id="projectclad-checkout-fulfill-title">Receive this order</h2>
        <p class="projectclad-cart-notice" style="margin: 0">
          Choose store pickup or delivery before checkout.
        </p>
        <div class="projectclad-fieldset" style="border: 1px solid #ccc; padding: 0.75rem; border-radius: 6px; margin-top: 0.5rem">
          <label style="display: block; margin-bottom: 0.5rem">
            <input type="radio" name="projectclad-checkout-fulfill" value="pickup" checked />
            Store pickup
          </label>
          <label style="display: block">
            <input type="radio" name="projectclad-checkout-fulfill" value="delivery" />
            Delivery
          </label>
        </div>
        <div class="projectclad-modal-buttons">
          <button
            type="button"
            class="projectclad-button projectclad-button--primary"
            data-projectclad-checkout-fulfill-continue
          >
            Continue to checkout
          </button>
          <button type="button" class="projectclad-button" data-projectclad-checkout-fulfill-cancel">
            Cancel
          </button>
        </div>
      </div>
    </div>

  <div class="projectclad-cart-actions__buttons">
    <a
      class="projectclad-button"
      href="{% if customer %}{{ view_projects_url }}{% else %}{{ login_url }}{% endif %}"
      data-projectclad-view-projects
    >
      View Projects
    </a>
    {% if has_custom_parts %}
      <p class="projectclad-cart-notice">Your cart contains custom parts. Checkout is blocked until parts are created.</p>
    {% endif %}
    {% if cart.item_count > 0 %}
      <button class="projectclad-button projectclad-button--primary" type="button" data-projectclad-save>
        Save Order
      </button>
      <form method="post" action="/cart/clear" style="display:inline;">
        <input type="hidden" name="return_to" value="/cart" />
        <button class="projectclad-button" type="submit">
          Clear cart
        </button>
      </form>
    {% endif %}
  </div>

    <div class="projectclad-modal" data-projectclad-modal hidden>
      <div class="projectclad-modal__content" role="dialog" aria-modal="true" aria-label="Save cart as order">
        <button class="projectclad-modal__close" type="button" data-projectclad-close>&times;</button>
        <h2>Save cart to project</h2>
        <form data-projectclad-form>
          <label for="projectclad-mode">Save mode</label>
          <select id="projectclad-mode" data-projectclad-mode>
            <option value="newProject">Create new project</option>
            <option value="existingProject">Save to existing project</option>
            <option value="existingJob">Save to existing order</option>
          </select>

          <div class="projectclad-section" data-projectclad-section="newProject">
            <label for="projectclad-project-name">Project name *</label>
            <input id="projectclad-project-name" type="text" data-projectclad-project-name required />
          </div>

          <div class="projectclad-section" data-projectclad-section="newProject">
            <div class="projectclad-field-row">
              <div class="projectclad-field">
                <label for="projectclad-po-number-new">Project #</label>
                <input id="projectclad-po-number-new" type="text" data-projectclad-po />
              </div>
              <div class="projectclad-field">
                <label for="projectclad-job-name">Order name *</label>
                <input id="projectclad-job-name" type="text" data-projectclad-job-name required />
              </div>
            </div>
            <div class="projectclad-field-row">
              <div class="projectclad-field">
                <label for="projectclad-company-name-new">Company name</label>
                <input
                  id="projectclad-company-name-new"
                  type="text"
                  data-projectclad-company
                />
              </div>
              <div class="projectclad-field">
                <label for="projectclad-order-number">PURCHASE ORDER #</label>
                <input id="projectclad-order-number" type="text" data-projectclad-order-number />
              </div>
            </div>
          </div>

          <div class="projectclad-section" data-projectclad-section="existingProject" hidden>
            <label for="projectclad-project-select">Project *</label>
            <select id="projectclad-project-select" data-projectclad-project required></select>
            <div class="projectclad-field-row">
              <div class="projectclad-field">
                <label for="projectclad-po-number-existing">Project #</label>
                <input id="projectclad-po-number-existing" type="text" data-projectclad-po />
              </div>
              <div class="projectclad-field">
                <label for="projectclad-job-name-existing">Order name *</label>
                <input id="projectclad-job-name-existing" type="text" data-projectclad-job-name required />
              </div>
            </div>
            <div class="projectclad-field-row">
              <div class="projectclad-field">
                <label for="projectclad-company-name-existing">Company name</label>
                <input
                  id="projectclad-company-name-existing"
                  type="text"
                  data-projectclad-company
                />
              </div>
              <div class="projectclad-field">
                <label for="projectclad-order-number-existing">PURCHASE ORDER #</label>
                <input id="projectclad-order-number-existing" type="text" data-projectclad-order-number />
              </div>
            </div>
          </div>

          <div class="projectclad-section" data-projectclad-section="existingJob" hidden>
            <label for="projectclad-project-select-job">Project *</label>
            <select id="projectclad-project-select-job" data-projectclad-project required></select>
            <div class="projectclad-field-row">
              <div class="projectclad-field">
                <label for="projectclad-po-number-job">Project #</label>
                <input id="projectclad-po-number-job" type="text" data-projectclad-po />
              </div>
              <div class="projectclad-field">
                <label for="projectclad-company-name-job">Company name</label>
                <input
                  id="projectclad-company-name-job"
                  type="text"
                  data-projectclad-company
                />
              </div>
            </div>
            <label for="projectclad-job-select">Order *</label>
            <select id="projectclad-job-select" data-projectclad-job required></select>
            <fieldset class="projectclad-fieldset">
              <legend>Quantity mode</legend>
              <label>
                <input type="radio" name="projectclad-quantity" value="add" checked />
                Add quantities
              </label>
              <label>
                <input type="radio" name="projectclad-quantity" value="replace" />
                Replace quantities
              </label>
            </fieldset>
          </div>

          <div class="projectclad-modal-buttons">
            <button class="projectclad-button projectclad-button--primary" type="submit" data-projectclad-clear>
              Save order & Clear cart
            </button>
            <button class="projectclad-button" type="submit">
              Save order
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="projectclad-modal projectclad-modal--duplicate" data-projectclad-duplicate-modal hidden>
      <div class="projectclad-modal__content" role="dialog" aria-modal="true" aria-label="Duplicate project name">
        <p class="projectclad-duplicate-message">You already have a project with this name, are you sure you want to save another?</p>
        <div class="projectclad-duplicate-buttons">
          <button type="button" class="projectclad-button projectclad-button--primary" data-projectclad-duplicate-yes>Yes</button>
          <button type="button" class="projectclad-button" data-projectclad-duplicate-no>No</button>
          <button type="button" class="projectclad-button" data-projectclad-duplicate-merge>Merge projects</button>
        </div>
      </div>
    </div>
  </div>

{% schema %}
{
  "name": "ProjectClad cart actions",
  "target": "section",
  "stylesheet": "project-clad-cart.css",
  "javascript": "project-clad-cart.js",
  "settings": []
}
{% endschema %}
