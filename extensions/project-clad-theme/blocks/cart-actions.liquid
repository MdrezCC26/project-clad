{% liquid
  assign project_clad_projects_path = '/apps/project-clad/projects'
  assign view_projects_url = project_clad_projects_path
  assign projects_return_to = project_clad_projects_path | url_encode
  assign login_url = '/customer_authentication/login?return_to=' | append: projects_return_to
%}
{% assign has_custom_parts = false %}
{% for item in cart.items %}
  {% if item.properties.shape_type == "L" or item.properties.shape_type == "Z" or item.properties.shape_type == "U" %}
    {% assign has_custom_parts = true %}
    {% break %}
  {% endif %}
{% endfor %}
{{ 'project-clad-save-modal.js' | asset_url | script_tag }}
<div
  class="projectclad-cart-actions"
  data-projectclad
  data-projectclad-customer-signed-in="{% if customer %}true{% else %}false{% endif %}"
  data-projectclad-login-url="{% if customer %}{{ view_projects_url }}{% else %}{{ login_url }}{% endif %}"
  data-projectclad-projects-url="/apps/project-clad/api/projects"
  data-projectclad-save-url="/apps/project-clad/api/save-job"
  data-projectclad-view-projects-url="{% if customer %}{{ view_projects_url }}{% else %}{{ login_url }}{% endif %}"
  data-projectclad-has-custom-parts="{{ has_custom_parts }}"
>
    <div
      class="projectclad-modal projectclad-modal--checkout-fulfillment"
      data-projectclad-checkout-fulfillment-modal
      hidden
    >
      <div
        class="projectclad-modal__content projectclad-reject-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="projectclad-checkout-fulfill-title"
      >
        <button
          type="button"
          class="projectclad-modal__close"
          data-projectclad-checkout-fulfill-close
          aria-label="Close"
        >
          &times;
        </button>
        <h2 id="projectclad-checkout-fulfill-title" data-projectclad-section-underline>Receive this order</h2>
        <p class="projectclad-cart-notice projectclad-modal__lede">
          Choose store pickup or delivery before checkout.
        </p>
        <fieldset class="projectclad-fieldset projectclad-fieldset--radios" aria-label="Fulfillment method">
          <label class="projectclad-fieldset__choice">
            <input type="radio" name="projectclad-checkout-fulfill" value="pickup" checked />
            Store pickup
          </label>
          <label class="projectclad-fieldset__choice">
            <input type="radio" name="projectclad-checkout-fulfill" value="delivery" />
            Delivery
          </label>
        </fieldset>
        <div class="projectclad-modal-buttons projectclad-actions">
          <button
            type="button"
            class="projectclad-button projectclad-button--primary projectclad-flat-btn"
            data-projectclad-checkout-fulfill-continue
          >
            Continue to checkout
          </button>
          <button type="button" class="projectclad-button projectclad-flat-btn" data-projectclad-checkout-fulfill-cancel>
            Cancel
          </button>
        </div>
      </div>
    </div>

  <div class="projectclad-cart-actions__buttons">
    {% if has_custom_parts %}
      <p class="projectclad-cart-notice">Your cart contains custom parts. Checkout is blocked until parts are created.</p>
    {% endif %}
    {% if cart.item_count > 0 %}
      <button class="projectclad-button" type="button" data-projectclad-save>
        Save Order
      </button>
      <form method="post" action="/cart/clear" class="projectclad-cart-actions__clear-form">
        <input type="hidden" name="return_to" value="/cart" />
        <button class="projectclad-button projectclad-button--danger" type="submit">
          Clear cart
        </button>
      </form>
    {% endif %}
    <a
      class="projectclad-button"
      href="{% if customer %}{{ view_projects_url }}{% else %}{{ login_url }}{% endif %}"
      data-projectclad-view-projects
    >
      View Projects
    </a>
  </div>

  {% render 'projectclad-save-modal', intent: 'cart' %}
</div>

{% schema %}
{
  "name": "ProjectClad cart actions",
  "target": "section",
  "stylesheet": "project-clad-cart.css",
  "javascript": "project-clad-cart.js",
  "settings": []
}
{% endschema %}
